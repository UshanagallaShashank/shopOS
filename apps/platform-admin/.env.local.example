# Copy this to .env.local and fill in your values — never commit .env.local

# Backend API — FastAPI running locally
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase — get these from: supabase.com → your project → Settings → API
# URL looks like: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon key is safe to expose in the browser — it's public by design
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
