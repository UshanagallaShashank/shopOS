# Copy this to .env and fill in your values — never commit .env with real secrets

DATABASE_URL=postgresql+asyncpg://shopos:shopos@localhost/shopos
REDIS_URL=redis://localhost:6379
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Secret keys — only people with these can register as that role
PLATFORM_ADMIN_SECRET=your-platform-admin-secret
ORG_ADMIN_SECRET=your-org-admin-secret
