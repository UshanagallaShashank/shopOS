# Copy this to .env.local and fill in your values — never commit .env.local

# Database — matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql+asyncpg://shopos:shopos@localhost/shopos

# Redis — local docker instance
REDIS_URL=redis://localhost:6379

# Firebase — Firebase Console → Project Settings → General → Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# App
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
